{
  "opencollection": "1.0.0",
  "info": {
    "name": "UCDP - The Public BattleDeaths OneSided API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-ucdp-access-token",
      "value": "{{x-ucdp-access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "OneSided",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/OneSided/{version}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ucdpapi.pcr.uu.se/api/OneSided/:version",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "pagesize",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "Country",
                "value": "",
                "type": "query"
              },
              {
                "name": "Dyad",
                "value": "",
                "type": "query"
              },
              {
                "name": "Year",
                "value": "",
                "type": "query"
              },
              {
                "name": "Key",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}